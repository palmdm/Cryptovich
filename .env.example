# Most settings below can also be changed without the server, in the admin
# area: Admin -> "Редактирование параметров" (it asks for a 2FA code). A
# value saved there wins over this file; "Reset" there goes back to it.
# What has to stay here — the database, Redis, the site's address, ports,
# storage, keys — is listed on that page too, read-only.

# --- Core ---
# The containers pin NODE_ENV=production themselves (see docker-compose.yml)
# — this value only affects host-side `pnpm dev`. Do not rely on it to make
# a deployment production: env_file cannot override what compose sets.
NODE_ENV=development
# Required. Compose refuses to start without it rather than defaulting to
# something guessable. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
# DATABASE_URL's port is independent from POSTGRES_PORT below (this is a
# full connection string used directly by host-side tools like `pnpm
# db:migrate`) — if you change POSTGRES_PORT, update this to match.
# Must carry the same POSTGRES_PASSWORD as above.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/platform
# The test suite runs against its own database so its fixture users don't
# pile up in the development one (and in the public author directory).
# Create it once with `pnpm db:test:setup`.
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/platform_test
REDIS_URL=redis://localhost:6380
# Host-side Docker Compose port mappings only (docker-compose.yml reads
# these via `${VAR:-default}`) — containers still talk to each other on
# Postgres/Redis's standard 5432/6379 internally regardless of these.
POSTGRES_PORT=5433
REDIS_PORT=6380
# WEB_ORIGIN, API_PORT, and WEB_PORT together decide where things actually
# are: WEB_ORIGIN is what the API's CORS check compares the browser's
# request origin against, API_PORT is what the API actually listens on
# (both inside and outside its container — see docker-compose.yml), and
# WEB_PORT is only the *host*-side port docker-compose maps to the web
# container's fixed internal port 3000. Change WEB_ORIGIN's port and
# WEB_PORT together, or the browser ends up talking to the app on a port
# the API doesn't recognize as an allowed CORS origin.
#
# The browser only ever talks to the web port: the web server forwards
# /api/* to the API over the compose network. So behind a reverse proxy or
# WAF, only WEB_PORT has to be reachable. Set WEB_ORIGIN to the address
# people actually open (e.g. https://example.com) — it is used for links
# in mail, feeds and federation, and https:// there makes the session
# cookie Secure (override with COOKIE_SECURE=true|false).
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
WEB_PORT=3000
# Which host interface each published port listens on. The database,
# Redis and the API default to loopback: Docker publishes ports past host
# firewalls like ufw, Redis here has no password, and the site reaches the
# API through its own /api proxy — a directly reachable API skips whatever
# the front door (a WAF, nginx) filters. WEB_BIND stays public if nginx
# runs on another host.
WEB_BIND=0.0.0.0
API_BIND=127.0.0.1
POSTGRES_BIND=127.0.0.1
REDIS_BIND=127.0.0.1
# Only to point the site at an API on a different origin; it is baked in
# at build time. Leave unset to use the built-in /api proxy.
# NEXT_PUBLIC_API_URL=https://api.example.com

# --- Admin ---
# On start, if there is no active administrator, the API creates one with
# this name. Leave ADMIN_PASSWORD empty to have one generated and printed
# once in the API log (`docker compose logs api`); if you set it, use at
# least 10 characters. Neither is re-read once the admin exists: change
# the password with `./scripts/manage-users.sh set-admin-password --prompt`,
# and rename with `./scripts/manage-users.sh sync-admin-name`.
# ADMIN_BOOTSTRAP=false turns this off; the first account registered then
# becomes the administrator instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_BOOTSTRAP=true
# Administrators sign in with two factors. One without an authenticator
# app is shown the QR code at sign-in, and the admin area stays shut until
# it is set up. A lost device: ./scripts/manage-users.sh disable-2fa <name>
# (the QR code is shown again at the next sign-in). Turn the requirement
# off only if you must.
ADMIN_REQUIRE_2FA=true

# --- Error reports (optional) ---
# A Sentry DSN turns on error reports from the API, the worker, the web
# server and the status page — to sentry.io, a self-hosted Sentry or
# GlitchTip: the server is whatever the DSN names. Empty: nothing is sent.
# A report carries the error, its stack and where it happened (a route
# pattern, a job's name) — never a reader's address, cookies, email or
# what they sent. Takes effect on restart.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Gate (the "updating" page) and the status page ---
# Two small services in a compose project of their own (deploy/gate), so
# they keep running through `docker compose down` and every update:
#  - the gate, an nginx in front of the site: while the site is down or
#    rebuilding, visitors get deploy/maintenance/index.html, not an error.
#    It stays in front for good: the WAF points at GATE_PORT, the site sits
#    behind it on WEB_BIND=127.0.0.1, WEB_PORT=3013. The first run of
#    scripts/upgrade.sh writes those three here by itself (keeping the old
#    file as .env.before-gate) — nothing to set, nothing to switch back;
#  - /status, an outside monitor like UptimeRobot: it checks every part of
#    Cryptovich on this machine's loopback (WEB_PORT, API_PORT, POSTGRES_PORT,
#    REDIS_PORT, WORKER_HEALTH_PORT) and keeps saying what is down.
# scripts/upgrade.sh starts and updates both. By hand:
#   docker compose --env-file .env -f deploy/gate/docker-compose.yml up -d --build
# GATE_PORT=off keeps the gate out (WEB_PORT stays where the WAF points);
# then only the status service starts, and /status needs nginx in front
# (deploy/nginx-cryptovich.conf).
# GATE_PORT=3003
# WEB_UPSTREAM=127.0.0.1:3013
STATUS_PORT=3005
STATUS_BIND=127.0.0.1
# The worker's health port on loopback, for the status page.
# WORKER_HEALTH_PORT=3006
# The updater (deploy/updater, beside the gate) installs a newer release
# when an administrator asks from the site (the version under the menu →
# "Update"). It installs only a release of palmdm/Cryptovich on GitHub,
# newer than this one and signed with deploy/release-key.pub; it listens
# on nothing, but it has Docker's socket. off leaves it out.
# SELF_UPDATE=on

# --- Email ---
# Optional. Unset means this server sends no mail at all: password reset
# and address verification then refuse up front with a clear message
# rather than accepting a request whose mail never arrives, and the only
# account recovery is ./scripts/manage-users.sh set-password.
#
# One URL is the whole configuration — every provider documents one:
#   SMTP_URL=smtps://user:pass@smtp.example.com:465
#   SMTP_URL=smtp://user:pass@smtp.example.com:587
SMTP_URL=
EMAIL_FROM=Cryptovich <no-reply@example.com>

# --- Client addresses ---
# Which proxies in front of the API to believe about the client's address
# (X-Forwarded-For). Every per-address limit — sign-in attempts above all —
# is keyed on it. The default believes hops on loopback and private
# networks (the web container, nginx, a WAF on the same host) and takes the
# first address beyond them as the client's. Behind a CDN such as
# Cloudflare, list its ranges or give a hop count ("3"). Never "true": that
# believes whatever the client itself writes in the header.
TRUST_PROXY=

# --- Registration ---
# "invite" (the default, and what ships) requires a code to create an
# account. "open" lets anyone register — set it deliberately, and only if
# you mean to run a public instance. The very first account on an empty
# database is always created without a code, as an administrator.
# This is only the starting value: once an administrator changes it under
# Admin -> Settings -> Registration, that stored choice wins over .env.
# In open mode a code typed at sign-up is still redeemed, and the new
# account's username shows who invited it on hover.
REGISTRATION_MODE=invite
# Accounts are created in a browser on this site, never by a script: a
# sign-up must come from WEB_ORIGIN, carry no API token, and answer a
# one-time proof-of-work challenge the page solves in about a second.
# REGISTRATION_POW_BITS sets how hard (18 by default; each step doubles
# the work, from 8 to 26). Turn the whole check off only if you have a
# reason to create accounts without a browser.
REGISTRATION_BOT_CHECK=true
REGISTRATION_POW_BITS=18

# --- Birthdays ---
# On an author's birthday their subscribers get a notification. The day is
# reckoned in UTC; this is the UTC hour from which it is sent (9 = noon in
# Moscow), so nobody's phone lights up at three in the morning.
BIRTHDAY_NOTIFY_HOUR_UTC=9

# --- Federation (ActivityPub) ---
# Which instances this server federates with. Every follower is a delivery
# on every future post, so an open instance's outbound traffic grows with
# the whole network. "open" (the default) accepts follows from anywhere;
# "allowlist" accepts only the domains named below, which is how you keep
# the bandwidth bill bounded.
#
# A leading dot covers subdomains: ".example.com" matches a.example.com and
# example.com, but not notexample.com. Without a dot the match is exact.
# The blocklist always wins, in either mode.
FEDERATION_MODE=open
FEDERATION_ALLOWED_DOMAINS=
FEDERATION_BLOCKED_DOMAINS=

# Delivery itself is real (packages/integrations/src/federation) — HTTP
# Signature-signed Create/Update/Delete activities to a target instance's
# shared inbox. Nothing here needs a platform-wide secret: each creator's
# actor keypair is generated per-creator when they enable federation
# (CreatorFederationSettings). Actor, WebFinger and NodeInfo documents are
# served, so a remote instance can discover and follow an author here —
# which needs API_PUBLIC_URL to be the real public HTTPS origin.

# --- Sticker import providers ---
# Telegram's Bot API needs only a bot token (no per-creator OAuth) to call
# getStickerSet/getFile — create a bot via @BotFather and paste its token
# here to import a Telegram sticker set into the server's sticker library
# (Admin → Stickers). Sharkey/Misskey imports need nothing.
TELEGRAM_BOT_TOKEN=
# The same bot as a bridge for members (true/false): new posts in their
# Telegram, following authors from there, publishing by writing to it
# (Dashboard -> Telegram). Needs TELEGRAM_BOT_TOKEN; also switchable in
# Admin -> "Редактирование параметров".
TELEGRAM_BRIDGE=false

# --- File uploads (post attachments, avatars) ---
# Files are written with a server-generated key, never the client's
# filename. Local disk by default: UPLOAD_DIR is a named volume in
# docker-compose, so it survives a container recreate but is part of what
# `scripts/backup.sh` has to capture.
UPLOAD_DIR=./data/uploads
#
# Set S3_BUCKET to move uploads to any S3-compatible bucket instead
# (AWS S3, Cloudflare R2, Backblaze B2, MinIO). Downloads still stream
# through the API rather than via bucket URLs, so EntitlementService
# stays the only thing deciding who may read a gated file — keep the
# bucket private.
#   S3_ENDPOINT is required for everything except AWS itself.
#   S3_REGION defaults to "auto", which is what R2 expects.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=5242880
# Administrators' own limit per file (default 50 MB).
ADMIN_MAX_UPLOAD_BYTES=52428800
# The longest a post may be, in characters (default 1200). Posts already
# longer can still be edited, as long as they do not grow.
POST_MAX_CHARS=1200
# true keeps the whole server out of search engines: every page says
# noindex and robots.txt disallows everything. Authors can opt out one by
# one either way (Кабинет → «Поисковики»).
HIDE_FROM_SEARCH_ENGINES=false
# Images uploaded before uploads were optimised are re-encoded once when
# the API starts (already-optimised files are skipped, so later starts do
# nothing). Leave on unless you have a reason: Mastodon drops avatars and
# headers over 2MB, so an old large avatar never shows on other servers.
REPROCESS_IMAGES_ON_START=true
# Where the API is reachable from outside. Behind the built-in proxy that
# is WEB_ORIGIN + /api — set both to the address people actually open.
# Needed for absolute URLs in generated content an external tool fetches
# directly, like podcast RSS `<enclosure>` links, and it is what federation
# derives an author's `@name@host` from (the federation endpoints
# themselves stay at the origin's root, where the fediverse looks for
# them — /.well-known, /nodeinfo and /federation are proxied there).
API_PUBLIC_URL=http://localhost:3000/api

# The version shown under the menu, in the API and worker logs and in
# NodeInfo. Empty means the version this build ships with. Takes effect on
# restart (docker compose up -d), no rebuild. Letters, digits, . + - _ only.
APP_VERSION=

# The site icon: favicon, app icon when installed, and the icon in
# notifications. An https:// address, or a file in ./branding mounted at
# /branding (e.g. FAVICON=/branding/favicon.png). Empty means the built-in
# Cryptovich mark. The site serves it itself at /favicon.ico, so a WAF or proxy in
# front needs no extra rule. Changed in the admin area, it applies at once.
FAVICON=

# Browser push notifications. Left empty, the server makes its own keypair
# on first use and keeps it — set these only to carry an existing one over
# from another install. Changing them unsubscribes every browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
