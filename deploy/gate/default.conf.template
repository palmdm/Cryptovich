# Filled in by the nginx image at start: ${GATE_PORT}, ${WEB_UPSTREAM},
# ${STATUS_UPSTREAM} (see docker-compose.yml). nginx's own variables are
# left alone.

server {
    listen ${GATE_PORT};

    # The API caps uploads itself (the maxUploadBytes setting).
    client_max_body_size 0;

    # While the site is down or being rebuilt: the "updating" page, as 503
    # with Retry-After. Only the gate's own errors land here; a 503 the
    # site answers itself passes through as it was.
    error_page 502 503 504 =503 /maintenance.html;
    location = /maintenance.html {
        root /srv/maintenance;
        try_files /index.html =404;
        internal;
        add_header Retry-After 60 always;
        add_header Cache-Control "no-store" always;
    }

    # The status page, straight to its own service — never the "updating"
    # page: /status is where to see what is down. Should the status
    # service itself be restarting, a line saying so.
    location = /status {
        proxy_pass http://${STATUS_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header Accept-Language $http_accept_language;
        error_page 502 503 504 = @status_restarting;
    }
    location = /status.json {
        proxy_pass http://${STATUS_UPSTREAM};
        proxy_set_header Host $http_host;
        error_page 502 503 504 = @status_restarting;
    }
    location @status_restarting {
        charset utf-8;
        default_type text/plain;
        add_header Retry-After 30 always;
        add_header Cache-Control "no-store" always;
        return 503 "Страница состояния перезапускается — обновите через полминуты.\nThe status page is restarting — try again in half a minute.\n";
    }

    location / {
        # By hand, with the site up: `touch deploy/maintenance/on` shows the
        # page to everyone, deleting the file ends it. No restart needed.
        if (-f /srv/maintenance/on) {
            return 503;
        }

        proxy_pass http://${WEB_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Byte for byte as it came ($http_host, not nginx's normalised
        # $host): an inbound federation delivery is signed over the Host
        # header, and the WAF in front already said which scheme and
        # address the reader used.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
        proxy_connect_timeout 3s;
    }
}
